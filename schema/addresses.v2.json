{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SvitloSk Addresses v2",
  "type": "object",
  "required": ["meta", "settlements"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema", "hromada", "version", "generated_at", "source_sha256", "counts"],
      "properties": {
        "schema": { "const": 2 },
        "hromada": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
        "generated_at": { "type": "string", "minLength": 10 },
        "source_sha256": { "type": "string" },
        "counts": {
          "type": "object",
          "required": ["settlements", "streets", "addresses", "multi_subqueue"],
          "properties": {
            "settlements": { "type": "integer", "minimum": 1 },
            "streets": { "type": "integer", "minimum": 1 },
            "addresses": { "type": "integer", "minimum": 1 },
            "multi_subqueue": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "settlements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["u", "streets"],
        "additionalProperties": false,
        "properties": {
          "u": { "type": "string" },
          "streets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[1-6]\\.[12]$"
                }
              }
            }
          }
        }
      }
    }
  }
}
